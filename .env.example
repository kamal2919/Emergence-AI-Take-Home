SIGNALDESK_LLM_API_KEY=replace-with-your-local-api-key
SIGNALDESK_LLM_MODEL=gpt-4.1-mini
SIGNALDESK_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Optional: only set this if local Python cannot validate a public site's TLS
# certificate. On this macOS host, the system bundle is /etc/ssl/cert.pem.
# SIGNALDESK_CA_BUNDLE=/etc/ssl/cert.pem
